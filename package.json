{
  "name": "kapit-bisig",
  "version": "1.0.0",
  "private": true,
  "description": "Kapit-Bisig Monorepo - Web, Backend, and Mobile",
  "scripts": {
    "dev": "concurrently -n \"web,server,mobile\" -c \"blue,green,magenta\" \"npm run dev:web\" \"npm run dev:server\" \"npm run dev:mobile\"",
    "dev:web": "cd apps/web/apps && npm run dev:clean",
    "dev:server": "cd apps/web/apps && npm run server:dev",
    "dev:mobile": "cd mobile && npm run start",
    "dev:web-server": "concurrently -n \"web,server\" -c \"blue,green\" \"npm run dev:web\" \"npm run dev:server\"",
    "install:all": "npm install && cd apps/web/apps && npm install && cd ../../../mobile && npm install",
    "build:web": "cd apps/web/apps && npm run build",
    "test:auth:newman": "npx newman run docs/postman/KapitBisig_Auth_Security.postman_collection.json -e docs/postman/KapitBisig_Local.postman_environment.json --reporters cli",
    "test:auth:newman:insecure": "npx newman run docs/postman/KapitBisig_Auth_Security.postman_collection.json -e docs/postman/KapitBisig_Local.postman_environment.json --reporters cli --insecure",
    "test:api:phase3": "cd apps/web/apps/server && npx tsx test/runPhase3NewmanTests.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18 <23"
  }
}
