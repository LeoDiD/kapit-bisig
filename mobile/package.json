{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "prestart": "node ../scripts/configure-local-network.js",
    "prestart:lan": "node ../scripts/configure-local-network.js",
    "prestart:tunnel": "node ../scripts/configure-local-network.js",
    "preandroid": "node ../scripts/configure-local-network.js",
    "preios": "node ../scripts/configure-local-network.js",
    "start": "expo start --go --lan --clear --port 8082",
    "start:lan": "expo start --go --lan --clear",
    "start:tunnel": "expo start --go --tunnel --clear",
    "start:dev-client": "expo start --dev-client --lan --clear --port 8082",
    "android": "expo start --go --android --lan --clear --port 8082",
    "ios": "expo start --go --ios --lan --clear --port 8082",
    "web": "expo start --web --clear --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:policy": "tsc --project tsconfig.test.json && node --test --test-reporter spec .test-dist/services/sync/__tests__/ResidentOfflineStore.test.js"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~56.0.19",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "~56.0.19",
    "expo-background-task": "~56.0.19",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.23",
    "expo-dev-client": "~56.0.19",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.9",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.24",
    "expo-image-picker": "~56.0.23",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-media-library": "~56.0.10",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@react-native/jest-preset": "^0.85.3",
    "@types/react": "~19.2.2",
    "expo-module-scripts": "^5.0.8",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
