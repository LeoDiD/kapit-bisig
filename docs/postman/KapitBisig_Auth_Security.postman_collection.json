{
  "info": {
    "name": "Kapit-Bisig Auth Security Tests",
    "description": "Run these requests in order.\n\nPrerequisites:\n1) Server running at {{baseUrl}}\n2) Valid SUPERADMIN or LGU_STAFF credentials for unified auth\n3) Optional: an approved household resident for household auth tests\n\nNotes:\n- Unified auth uses httpOnly cookie (Postman cookie jar handles it)\n- Household auth uses Bearer token\n- Some tests intentionally expect 400/401 errors",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Check (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Unified Login Valid (200)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{unifiedUsername}}\",\n  \"password\": \"{{unifiedPassword}}\",\n  \"rememberMe\": false\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Login success true', function () { pm.expect(json.success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Unified Me After Login (200 via cookie)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Unified Login Wrong Password (401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{unifiedUsername}}\",\n  \"password\": \"wrong-password\",\n  \"rememberMe\": false\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Unified Login Extra Field Rejected (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{unifiedUsername}}\",\n  \"password\": \"{{unifiedPassword}}\",\n  \"rememberMe\": false,\n  \"isAdmin\": true\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Unified Login NoSQL Injection Rejected (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": { \"$ne\": \"\" },\n  \"password\": \"x\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Unified Logout (200)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Unified Me After Logout (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Household Login Valid (200, saves bearer)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobileNumber\": \"{{householdMobile}}\",\n  \"password\": \"{{householdPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/household/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "if (json?.data?.token) { pm.environment.set('residentBearer', json.data.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Household Logout With Bearer (200)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{residentBearer}}" }
        ],
        "url": "{{baseUrl}}/api/household/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Household Logout Reuse Same Token (401 revoked)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{residentBearer}}" }
        ],
        "url": "{{baseUrl}}/api/household/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Resident Register Invalid Mobile (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"fullName\": \"Test User\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"gender\": \"Male\",\n  \"mobileNumber\": \"12345\",\n  \"password\": \"Valid@123\",\n  \"city\": \"Sample\",\n  \"barangay\": \"Sample Barangay\",\n  \"streetAddress\": \"Street 1\",\n  \"householdSize\": 1,\n  \"vulnerableMembers\": [],\n  \"vulnerableCounts\": {},\n  \"idType\": \"National ID\",\n  \"idNumber\": \"ID-TEST-001\",\n  \"frontIdImage\": \"base64-front\",\n  \"backIdImage\": \"base64-back\",\n  \"faceImage\": \"base64-face\"\n}"
        },
        "url": "{{baseUrl}}/api/residents/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    }
  ]
}
