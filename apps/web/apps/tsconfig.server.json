{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./server",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["server/**/*"],
  "exclude": [
    "node_modules",
    "server/test/**/*",
    "server/**/*.test.ts",
    "server/**/*.spec.ts",
    "server/**/*.unit.ts",
    "server/**/*.integration.ts",
    "server/test-*.ts"
  ]
}
