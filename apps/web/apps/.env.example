# Core server configuration
MONGODB_URI=mongodb://localhost:27017/kapit-bisig
JWT_SECRET=replace-with-a-long-random-server-secret
PORT=3001

# Semaphore SMS - server only. Never prefix these with NEXT_PUBLIC_ or EXPO_PUBLIC_.
SMS_PROVIDER=semaphore
SMS_API_KEY=
SMS_SENDER_NAME=KapitBisig

# Enables Expo push delivery after Firebase/FCM and EAS credentials are configured.
EXPO_PUSH_ENABLED=false