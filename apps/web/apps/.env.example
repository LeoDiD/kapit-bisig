# ──────────────────────────────────────────────────────────────
# Server Environment Variables
# Copy this file to .env.local and fill in your values.
# ⚠️  NEVER commit .env.local — it is in .gitignore.
# ──────────────────────────────────────────────────────────────

# Server Configuration
PORT=3001
NODE_ENV=development

# ── MongoDB Connection ──────────────────────────────────────
# For production use mongodb+srv:// (Atlas) — TLS enabled by default.
# For local dev use mongodb://localhost:27017/kapit-bisig
MONGODB_URI=mongodb://localhost:27017/kapit-bisig

# ── JWT Configuration ───────────────────────────────────────
# IMPORTANT: Must be at least 32 characters. In production use ≥ 64 random hex chars.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_at_least_64_random_hex_characters

# ── CORS Configuration ─────────────────────────────────────
# In production, restrict to your frontend domain(s).
CORS_ORIGIN=http://192.168.1.72:3000

# ── Superadmin Account (env-based, no DB record) ───────────
# Username (lowercased at login time)
SUPERADMIN_USERNAME=admin
# bcrypt hash of the superadmin password
# Generate: node -e "require('bcrypt').hash('YourStrongPassword!', 12).then(h => console.log(h))"
SUPERADMIN_PASSWORD_HASH=$2b$12$CHANGE_ME

# ── Blockchain Hash Salt ────────────────────────────────────
HASH_SALT=CHANGE_ME_random_salt

# ── Cookie Settings (optional — defaults derived from NODE_ENV) ──
# COOKIE_NAME=sa_token
# COOKIE_SECURE=false

# ── Blockchain / Ganache (optional for local dev) ───────────
# GANACHE_URL=http://127.0.0.1:7545
# CONTRACT_ADDRESS=0x...
# DEPLOYER_PRIVATE_KEY=0x...

# ── Face Recognition Backend (optional) ─────────────────────
# FACE_RECOGNITION_API_URL=http://localhost:8000

# ── SMTP / Email (required for Forgot Password OTP) ────────
# Use Gmail App Passwords: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pulanamanok123@gmail.com
SMTP_PASS=mbhy ckul gsvf audz
APP_NAME=KapitBisig
# FRONTEND_URL=http://192.168.1.72:3000

# ── Rate Limiting (optional overrides) ──────────────────────
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=5
# REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
# REGISTRATION_RATE_LIMIT_MAX=3
