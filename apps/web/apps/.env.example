# Core server configuration
MONGODB_URI=mongodb://localhost:27017/kapit-bisig
JWT_SECRET=replace-with-a-long-random-server-secret
PORT=3001

# SMS Provider configuration (server only - never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_)
# Options: unisms, semaphore, twilio, vonage
SMS_PROVIDER=unisms
SMS_API_KEY=your_sms_api_key_or_secret
SMS_SENDER_NAME=UniSMS
# Twilio specific: TWILIO_ACCOUNT_SID=
# Vonage specific: VONAGE_API_SECRET=

# Enables Expo push delivery after Firebase/FCM and EAS credentials are configured.
EXPO_PUSH_ENABLED=false