# ----------------------------------------------------------------------
# Server Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local (it should stay gitignored).
# ----------------------------------------------------------------------

# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kapit-bisig

# JWT (min 32 chars; use >= 64 random hex chars in production)
JWT_SECRET=CHANGE_ME_use_at_least_64_random_hex_characters

# CORS
CORS_ORIGIN=http://localhost:3000

# Superadmin Account (env-based, no DB row)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD_HASH=$2b$12$CHANGE_ME

# Hash salt for on-chain hash derivation
HASH_SALT=CHANGE_ME_random_salt

# Cookie settings (optional)
# COOKIE_NAME=sa_token
# COOKIE_SECURE=false

# Blockchain / Sepolia (required for claim ledger writes)
CHAIN_ID=11155111
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
CONTRACT_ADDRESS=0x...
PRIVATE_KEY=0x...
CONFIRMATIONS_REQUIRED=2

# Frontend chain display helpers (optional)
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_TX_EXPLORER_BASE_URL=https://sepolia.etherscan.io/tx/

# Face Recognition Backend (optional)
# FACE_RECOGNITION_API_URL=http://localhost:8000

# SMTP / Email (required for forgot-password OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
APP_NAME=KapitBisig
# FRONTEND_URL=http://localhost:3000

# Rate limiting overrides (optional)
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=5
# REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
# REGISTRATION_RATE_LIMIT_MAX=3
